# Copy this file to .env and fill in the values for your IG account.
# Non-empty .env values override process-level environment variables.

# Engine defaults
ENGINE_YAHOO_PERIOD=60d
ENGINE_INTERVAL=15m
ENGINE_POLL_SECONDS=60
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8765
ENGINE_TICKER=AVGO
ENGINE_NO_BROWSER=0
ENGINE_NO_IG=0
ENGINE_ENABLE_LIVE_TRADING=0

# IG service credentials
IG_SERVICE_USERNAME=your_username
IG_SERVICE_PASSWORD=your_password
IG_SERVICE_API_KEY=your_api_key
IG_SERVICE_ACC_TYPE=DEMO
IG_SERVICE_ACC_NUMBER=your_account_number

# IG market/order mapping. Use JSON strings or paths to JSON files.
IG_EPIC_MAP={"MRVL":"YOUR_MARVELL_EPIC","AVGO":"YOUR_AVGO_EPIC"}
IG_DEAL_SIZE_MAP={"MRVL":1,"AVGO":1}

# IG order settings
IG_CURRENCY_CODE=USD
IG_EXPIRY=-
IG_FORCE_OPEN=0
IG_NO_CONFIRM_DEALS=0

# Optional IG test controls
RUN_IG_PLATFORM_TEST=0
RUN_IG_LIVE_TRADE_TEST=0
IG_TEST_MARVELL_EPIC=YOUR_MARVELL_EPIC
IG_LIVE_TEST_SIZE=1
IG_LIVE_TEST_CURRENCY=USD
IG_LIVE_TEST_EXPIRY=-
IG_LIVE_TEST_FORCE_OPEN=0
