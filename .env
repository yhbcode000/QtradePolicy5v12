# Qtrade Policy 5 local defaults.
# This file is loaded before process environment variables are read by the app.
# Non-empty values here override same-named system environment values.

ENGINE_YAHOO_PERIOD=60d
ENGINE_INTERVAL=15m
ENGINE_POLL_SECONDS=60
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8765
ENGINE_TICKER=AVGO
ENGINE_NO_BROWSER=0
ENGINE_NO_IG=0
ENGINE_ENABLE_LIVE_TRADING=0

IG_SERVICE_ACC_TYPE=DEMO
IG_CURRENCY_CODE=USD
IG_EXPIRY=-
IG_FORCE_OPEN=0
IG_NO_CONFIRM_DEALS=0

# Put secrets in your private local copy. Empty values are ignored by the loader.
# IG_SERVICE_USERNAME=
# IG_SERVICE_PASSWORD=
# IG_SERVICE_API_KEY=
# IG_SERVICE_ACC_NUMBER=
# IG_EPIC_MAP={"MRVL":"YOUR_MARVELL_EPIC"}
# IG_DEAL_SIZE_MAP={"MRVL":1}
